-- input data using load data 
LOAD DATA LOCAL INFILE
'C:/Users/thaon/Downloads/archive (1)/nykaa_campaign_data.csv'
INTO TABLE campaigns
FIELDS TERMINATED BY ','
ENCLOSED BY '"'
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS
(
    Campaign_ID,
    Campaign_Type,
    Target_Audience,
    Duration,
    Channel_Used,
    Impressions,
    Clicks,
    Leads,
    Conversions,
    Revenue,
    Acquisition_Cost,
    ROI,
    Language,
    Engagement_Score,
    Customer_Segment,
    @date_raw
)
SET Campaign_Date = STR_TO_DATE(@date_raw, '%d-%m-%Y'); -- mysql cannot convert dd-mm-yyyy to DATE -- using this code to convert

SET GLOBAL local_infile = 1;
SHOW GLOBAL VARIABLES LIKE 'local_infile';

 -- there is no bran column, update brand 
 Update campaigns Set Brand = 'Nykaa'
 Where Campaign_ID like 'NY-%' and Brand is NULL;
 
 
